# Admin panel (CRA) environment.
#
# Copy to `.env` and fill from your password manager / GitHub Environment
# secrets. NEVER commit a filled-in copy — a tracked `.env.production` is what
# leaked these values in the first place.
#
# WARNING: every REACT_APP_* value is compiled into the public browser bundle.
# Anything here is readable by anyone who loads the admin panel. The two
# signing/encryption keys below therefore do NOT belong in a client app at all
# and are slated to move behind a Supabase Edge Function.

# --- Supabase (anon key is public by design) ---
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=

# --- Legacy crypto / auth (MOVE SERVER-SIDE — see note above) ---
REACT_APP_CRYPTO_SECRET_KEY=
REACT_APP_SECRET_KEY=
REACT_APP_SECRET_OR_KEY=
REACT_APP_API_KEY=
